---
import type { StorefrontShellModel } from '../../features/storefront/models';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * Footer links come from the merchant's navigation menu, already filtered to
 * targets that are actually publishable, so nothing here can render a dead
 * link. Like the header, this renders on every page.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

<footer class="border-t border-line bg-paper/60">
  <div class="mx-auto max-w-6xl px-6 pt-12 pb-8">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4 pb-8 border-b border-line">
      <div class="sm:col-span-2">
        <div class="flex items-center gap-2 font-serif text-xl font-bold tracking-tight text-ink">
          <span>🧸</span> {model.storeName || 'Shelfie'}
        </div>
        <p class="mt-2 max-w-md text-sm text-muted">
          Custom 3D-sculpted keepsakes, pet figurines, and whimsy portrait gnomes. Crafted with precision 3D printing and artisan hand-finishing.
        </p>
        <p class="mt-3 text-xs font-medium text-brand">
          🛡️ 100% Likeness Guarantee: Digital revisions are always free before printing.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-ink">Explore</h3>
        <ul class="mt-3 space-y-2 text-xs uppercase tracking-wider text-muted">
          <li><a href="/products" class="hover:text-brand">All Figurines</a></li>
          <li><a href="/proof" class="hover:text-brand">Review 3D Proof</a></li>
          {
            model.footerLinks.map((link) => (
              <li><a href={link.href} class="hover:text-brand">{link.text}</a></li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-ink">Need Help?</h3>
        <p class="mt-3 text-xs text-muted">
          Questions about photo requirements, sizing, or custom styling?
        </p>
        <p class="mt-2 text-xs font-medium text-brand">
          hello@shelfie.com
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 pt-6 text-xs uppercase tracking-widest text-faint">
      <span>&copy; {new Date().getFullYear()} {model.storeName || 'Shelfie'}. All rights reserved.</span>
      <span>Handcrafted with precision &amp; care</span>
    </div>
  </div>
</footer>
