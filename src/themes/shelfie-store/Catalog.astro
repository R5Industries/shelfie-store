---
import type { CatalogPageModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import CatalogPagination from '../../features/storefront/controls/CatalogPagination.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * The catalog, rendered at both `/` and `/products`. It performs no queries and
 * parses no query parameters: every product, link, and URL on `model` is
 * already built and bounded.
 *
 * Keep <CatalogSort> and <CatalogPagination>. Their hrefs encode the query
 * semantics the catalog's canonical URLs and caching depend on, and their
 * landmarks and rel hints are what make a paginated series legible to crawlers.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: CatalogPageModel;
}

const { model } = Astro.props;
---

<div class="mb-8">
  <p class="text-xs uppercase tracking-[0.25em] text-muted">{model.eyebrow}</p>
  <h1 class="mt-2 font-serif text-4xl tracking-tight sm:text-5xl">{model.heading}</h1>
  <p class="mt-3 max-w-2xl text-base text-muted">
    Turn your favorite portraits and beloved pets into tactile, shelf-worthy 3D miniatures. Every piece comes with a digital 3D proof before printing.
  </p>
</div>

<div class="mb-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
  <div class="rounded-xl border border-line bg-surface p-4 shadow-xs">
    <div class="text-xl">📸</div>
    <h3 class="mt-2 text-sm font-bold text-ink">1. Upload Photos</h3>
    <p class="mt-1 text-xs text-muted">Snap photos from your phone. Clear lighting and natural poses work best.</p>
  </div>
  <div class="rounded-xl border border-line bg-surface p-4 shadow-xs">
    <div class="text-xl">🎨</div>
    <h3 class="mt-2 text-sm font-bold text-ink">2. Review 3D Proof</h3>
    <p class="mt-1 text-xs text-muted">Inspect the full 3D model from all angles. Digital revisions are always free.</p>
  </div>
  <div class="rounded-xl border border-line bg-surface p-4 shadow-xs">
    <div class="text-xl">🖨️</div>
    <h3 class="mt-2 text-sm font-bold text-ink">3. Printed &amp; Hand-Finished</h3>
    <p class="mt-1 text-xs text-muted">Full-color 3MF detail, protective UV-coating, and delivered to your doorstep.</p>
  </div>
</div>

{
  model.categories.length > 0 && (
    <div class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest text-muted">
      {model.categories.map((category) => (
        <a
          href={category.href}
          class="border-b border-transparent pb-0.5 hover:border-brand hover:text-brand"
        >
          {category.text}
        </a>
      ))}
    </div>
  )
}

<CatalogSort model={model.sort} />

{
  /* role="status" is the contract, not the wording: an empty catalog must
     announce itself to assistive technology rather than rendering a blank
     grid. Reword it freely; keep the role and keep it non-empty. */
  model.products.length === 0 && (
    <p role="status" class="text-muted">
      No products yet.
    </p>
  )
}

<ul class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-3">
  {model.products.map((card, i) => <ProductCard card={card} index={i} />)}
</ul>

<CatalogPagination model={model.pagination} />
