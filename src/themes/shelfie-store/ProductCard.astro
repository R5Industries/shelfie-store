---
import type { ProductCardModel } from '../../features/storefront/models';
import StoreImage from '../../features/storefront/controls/StoreImage.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store, and upstream will
 * not rewrite it. It renders every product card on the storefront: catalog,
 * category, search, and recommendations.
 *
 * The contract, in full:
 *   - `card` is a ProductCardModel. Its URLs, price string, and availability
 *     are already resolved; do not recompute them.
 *   - Render the image through <StoreImage>. It owns responsive attributes and
 *     LCP behavior; copying its markup to change spacing loses both.
 *   - `card.inStock` is a boolean on purpose. Exact stock counts are private.
 *
 * See CUSTOMIZING.md for the full store-owned surface.
 */
interface Props {
  card: ProductCardModel;
  /** Stagger index for the page-load reveal (capped at 8 steps). */
  index?: number;
  /** Heading level for the card title, so cards nested under a section heading
   *  keep the document outline correct. */
  headingLevel?: 'h2' | 'h3';
}

const { card, index = 0, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<li class="reveal group" style={`animation-delay:${Math.min(index, 8) * 60}ms`}>
  <a href={card.href} class="block">
    <div class="relative overflow-hidden rounded-xl border border-line bg-surface shadow-xs transition duration-300 group-hover:border-brand/40 group-hover:shadow-md">
      <StoreImage
        image={card.image}
        fade
        class={`aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]${card.inStock ? '' : ' opacity-60'}`}
      />
      <div class="absolute left-3 top-3 flex flex-col gap-1.5">
        <span class="rounded-full bg-paper/90 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-brand backdrop-blur-xs ring-1 ring-line">
          3D Printed
        </span>
        {
          !card.inStock && (
            <span class="rounded-full bg-surface/90 px-2.5 py-0.5 text-xs uppercase tracking-widest text-muted ring-1 ring-line">
              Sold out
            </span>
          )
        }
      </div>
    </div>
    <div class="mt-3 flex items-start justify-between gap-2">
      <div>
        <Heading class="text-sm font-semibold tracking-tight text-ink group-hover:text-brand">{card.name}</Heading>
        <p class="mt-0.5 text-xs text-muted">Includes free 3D digital proof</p>
      </div>
      <p class="text-sm font-medium tabular-nums text-ink">{card.formattedPrice}</p>
    </div>
  </a>
</li>
